#!/system/bin/sh
# DFRoot bootstrap — uruchamiany przez call_usermodehelper z kernel space
# SELinux i DEFEX są już wyłączone w tym momencie.

BOOT_SRC=/data/local/tmp/magisk-boot.img
BOOT_DEV=/dev/block/by-name/boot

touch /dev/dfm1

if [ ! -f "$BOOT_SRC" ]; then
    touch /dev/dfm_nosrc
    exit 1
fi

dd if="$BOOT_SRC" of="$BOOT_DEV" bs=4096 2>/dev/null
RC=$?

if [ $RC -eq 0 ]; then
    touch /dev/dfm6
else
    touch /dev/dfm_ddfail
fi

exit $RC
